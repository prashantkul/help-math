{
  "description": "Test scenarios for password reset functionality.",
  "valid_requests": [
    {
      "email": "teacher1@test.com",
      "expected": "Reset email sent, token valid for 1 hour"
    },
    {
      "email": "teacher2@test.com",
      "expected": "Reset email sent, token valid for 1 hour"
    }
  ],
  "invalid_requests": [
    {
      "email": "nonexistent@test.com",
      "expected": "Same success message (prevent enumeration)",
      "response_message": "If an account exists, a reset link has been sent"
    },
    {
      "email": "invalid-email",
      "expected": "Validation error - invalid email format"
    },
    {
      "email": "",
      "expected": "Validation error - email required"
    }
  ],
  "token_scenarios": [
    {
      "scenario": "valid_token",
      "token": "valid-token-abc123",
      "age_minutes": 30,
      "used": false,
      "expected": "Allow password reset"
    },
    {
      "scenario": "expired_token",
      "token": "expired-token-xyz789",
      "age_minutes": 65,
      "used": false,
      "expected": "Error: This link has expired or already been used"
    },
    {
      "scenario": "used_token",
      "token": "used-token-def456",
      "age_minutes": 30,
      "used": true,
      "expected": "Error: This link has expired or already been used"
    },
    {
      "scenario": "invalid_token",
      "token": "invalid-token-000",
      "expected": "Error: This link has expired or already been used"
    }
  ],
  "rate_limit_scenarios": [
    {
      "scenario": "within_limit",
      "email": "teacher1@test.com",
      "requests_in_last_hour": 4,
      "expected": "Allow request (5 per hour limit)"
    },
    {
      "scenario": "at_limit",
      "email": "teacher1@test.com",
      "requests_in_last_hour": 5,
      "expected": "Reject request - rate limit exceeded"
    }
  ],
  "password_validation": {
    "valid_passwords": [
      "password123",
      "MySecureP@ss1",
      "12345678"
    ],
    "invalid_passwords": [
      {
        "password": "short",
        "reason": "Less than 8 characters"
      },
      {
        "password": "",
        "reason": "Empty password"
      }
    ]
  }
}
