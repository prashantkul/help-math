{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            sp.problem_id,\n            p.original_text,\n            sp.completed_at,\n            sp.stars_earned,\n            sp.total_points_earned\n        FROM student_progress sp\n        JOIN problems p ON sp.problem_id = p.id\n        WHERE sp.student_id = $1 AND sp.is_complete = true\n        ORDER BY sp.completed_at DESC\n        LIMIT 10\n        ",
